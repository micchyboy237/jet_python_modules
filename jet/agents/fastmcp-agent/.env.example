# jet_python_modules/jet/agents/fastmcp-agent/.env
# Model tag/alias to request from llama-server (matches the model loaded by
# llama-server, or its --alias if you set one).
LLAMA_CPP_LLM_MODEL=qwen3.5-uncensored:2b

# Base URL of your running llama-server instance.
# NO trailing /v1 — the code appends /v1/chat/completions automatically.
# Same machine: http://127.0.0.1:8080
# Different machine on your LAN (e.g. Windows box): http://192.168.68.150:8080
LLAMA_CPP_LLM_URL=http://192.168.68.150:8080

# Seconds to wait before giving up on a generation request.
LLAMA_TIMEOUT=120

# Only needed by demo_client.py if llama_mcp_server.py isn't in the same
# folder as demo_client.py.
# LLAMA_MCP_SERVER_PATH=/absolute/path/to/llama_mcp_server.py