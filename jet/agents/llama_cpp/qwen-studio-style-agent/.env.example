# Llama.cpp server
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_MODEL=local-model

# SearXNG instance (still needed for search; run via pip: pip install searxng && searxng-run)
# OR replace web_search.py with DuckDuckGo if you want zero external services
SEARXNG_BASE_URL=http://localhost:8888

# Safety limits
MAX_AGENT_ITERATIONS=6
CODE_TIMEOUT_SEC=15
EXTRACTOR_MAX_CHARS=4000
